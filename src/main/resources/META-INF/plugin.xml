<idea-plugin>
    <id>dev.markusmayer.proberover</id>
    <name>probe-rs Debugging</name>
    <vendor>Markus Mayer</vendor>
    <description><![CDATA[
    Debug embedded Rust firmware in RustRover with probe-rs. Click Debug on a Cargo run configuration in a project
    whose <code>.cargo/config.toml</code> uses <code>probe-rs run --chip …</code> as its runner: the firmware is
    flashed, RTT/defmt logs get their own tab with colored levels and clickable locations, and probe-rs errors come
    with a suggested fix. Settings are under Build, Execution, Deployment | probe-rs.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.rust</depends>
    <depends>com.intellij.nativeDebug</depends>
    <dependencies>
        <!-- TOML parser for .cargo/config.toml and Cargo.toml -->
        <module name="intellij.libraries.jackson.dataformat.toml"/>
    </dependencies>

    <extensions defaultExtensionNs="org.rust">
        <debugger.driverConfigurationProvider
                id="ProbeRsDriverConfigurationProvider"
                implementation="dev.proberover.debugger.ProbeRsDriverConfigurationProvider"
                order="first"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="probe-rs" displayType="BALLOON"/>
        <toolWindow id="Peripherals" anchor="right" secondary="false" canCloseContents="false"
                    factoryClass="dev.proberover.peripherals.PeripheralsToolWindowFactory"/>
        <postStartupActivity implementation="dev.proberover.startup.ProbeRsStartupActivity"/>
        <toolWindow id="Live Watch" anchor="bottom" secondary="true" canCloseContents="false"
                    factoryClass="dev.proberover.watch.LiveWatchToolWindowFactory"/>
        <consoleFilterProvider implementation="dev.proberover.defmt.DefmtConsoleFilterProvider"/>
        <projectConfigurable parentId="build" id="dev.proberover.settings" displayName="probe-rs"
                             instance="dev.proberover.settings.ProbeRsConfigurable"/>
    </extensions>

    <actions>
        <action id="dev.proberover.AttachToRunningTarget" class="dev.proberover.actions.AttachToRunningTargetAction"
                text="Attach to Running Target with probe-rs"
                description="Debug the selected Cargo configuration without flashing or resetting the chip"
                icon="AllIcons.Debugger.AttachToProcess">
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="Debug"/>
        </action>
        <group id="dev.proberover.ToolsGroup" text="probe-rs" popup="true">
            <action id="dev.proberover.InstallProbeRs" class="dev.proberover.actions.InstallProbeRsAction"
                    text="Install or Update probe-rs" description="Install probe-rs-tools with cargo"/>
            <action id="dev.proberover.CopyUdevCommand" class="dev.proberover.actions.CopyUdevRulesCommandAction"
                    text="Copy udev Rules Setup Command"
                    description="Copy the command that installs probe-rs's udev rules (Linux)"/>
            <action id="dev.proberover.CreateWokwiDebugConfiguration" class="dev.proberover.wokwi.CreateWokwiDebugConfigurationAction"
                    text="Create Wokwi Debug Configuration"
                    description="Create a Remote Debug configuration that attaches GDB to the Wokwi simulator (from wokwi.toml)"/>
            <action id="dev.proberover.SaveCoreDump" class="dev.proberover.actions.SaveCoreDumpAction"
                    text="Save Core Dump" description="Save registers and RAM of the halted target with probe-rs"/>
            <action id="dev.proberover.CopyDiagnostics" class="dev.proberover.actions.CopyDiagnosticsAction"
                    text="Copy probe-rs Diagnostics"
                    description="Copy versions, detection, launch arguments and the last session's DAP traffic for a bug report"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>

    <projectListeners>
        <listener class="dev.proberover.runconfig.ProbeRsExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="dev.proberover.runconfig.OverridesFollowRenames"
                  topic="com.intellij.execution.RunManagerListener"/>
    </projectListeners>
</idea-plugin>
